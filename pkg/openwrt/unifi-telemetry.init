#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    mkdir -p /tmp/unifi-telemetry /tmp/unifi-reporters/clients /tmp/unifi-reporters/gateway
    chown root:unifi-report /tmp/unifi-telemetry
    chmod 2750 /tmp/unifi-telemetry
    chown -R unifi-report:unifi-report /tmp/unifi-reporters
    chmod 700 /tmp/unifi-reporters/clients /tmp/unifi-reporters/gateway

    procd_open_instance collector
    procd_set_param command /usr/bin/python3 /usr/lib/unifi-reporter/openwrt_snapshot.py --loop --output /tmp/unifi-telemetry/snapshot.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param nice 10
    procd_set_param respawn 300 30 3
    procd_close_instance

    for profile in clients gateway; do
        [ -f "/etc/unifi-reporters/$profile.json" ] || continue
        case "$profile" in
            clients) entry=client_reporter.py ;;
            gateway) entry=router_telemetry.py ;;
        esac
        procd_open_instance "$profile"
        procd_set_param command /usr/bin/python3 "/usr/lib/unifi-reporter/$entry" --config "/etc/unifi-reporters/$profile.json" --state-dir "/etc/unifi-reporters/state/$profile" --status-dir "/tmp/unifi-reporters/$profile"
        procd_set_param user unifi-report
        procd_set_param group unifi-report
        procd_set_param no_new_privs 1
        procd_set_param nice 10
        procd_set_param limits core="0" nofile="64" as="134217728"
        procd_set_param stdout 1
        procd_set_param stderr 1
        # Fail closed if the filesystem jail cannot be created. No ubus socket
        # or router configuration is mounted in either publisher.
        procd_add_jail "unifi-$profile" log ronly procfs requirejail
        procd_add_jail_mount /usr /lib /bin /sbin/ip /etc/passwd /etc/group /etc/TZ
        procd_add_jail_mount "/etc/unifi-reporters/$profile.json" /tmp/unifi-telemetry
        procd_add_jail_mount_rw "/etc/unifi-reporters/state/$profile" "/tmp/unifi-reporters/$profile"
        # No respawn: incompatible controller replies leave the publisher off.
        procd_close_instance
    done
}
